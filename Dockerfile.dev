# Dev image: full npm deps + toolchain for native modules (better-sqlite3).
# Source is bind-mounted at runtime for hot reload (`npm run dev` / node --watch).
FROM node:22-slim

RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    gosu \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

RUN mkdir -p /data /backups /app/modules

ENV BACKUP_DIR=/backups
ENV NODE_ENV=development

EXPOSE 3000

ENTRYPOINT ["/entrypoint.sh"]
CMD ["npm", "run", "dev"]
